{
  "name": "react-dnd-test-utils",
  "version": "16.0.1",
  "license": "MIT",
  "homepage": "https://github.com/nosferatu500/react-dnd#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nosferatu500/react-dnd.git",
    "directory": "packages/test-utils"
  },
  "bugs": {
    "url": "https://github.com/nosferatu500/react-dnd/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/cjs",
    "dist/esm",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "clean": "shx rm -rf dist .turbo tsconfig.tsbuildinfo",
    "_build_types": "tsc -b tsconfig.json",
    "_build_esm": "swc src -d dist/esm --strip-leading-paths -C module.type=es6 -C module.ignoreDynamic=true",
    "_build_cjs": "swc src -d dist/cjs --strip-leading-paths -C module.type=commonjs",
    "build": "run-p _build_types _build_esm _build_cjs && npm run _finalize",
    "check": "biome check src",
    "release": "npm publish --access public",
    "_finalize": "node ../../scripts/finalize-dist.mjs",
    "check:exports": "attw --pack . --profile node16"
  },
  "devDependencies": {
    "dnd-core": "^16.0.1",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dnd-test-backend": "^16.0.1"
  },
  "peerDependencies": {
    "@testing-library/react": ">= 16",
    "@types/react": "^18.0.0 || ^19.0.0",
    "@types/react-dom": "^18.0.0 || ^19.0.0",
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0",
    "react-dnd": ">= 16",
    "react-dnd-html5-backend": ">= 16",
    "react-dnd-test-backend": ">= 16"
  },
  "peerDependenciesMeta": {
    "@testing-library/react": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    },
    "@types/react-dom": {
      "optional": true
    },
    "react-dnd-html5-backend": {
      "optional": true
    },
    "react-dnd-test-backend": {
      "optional": true
    }
  }
}
