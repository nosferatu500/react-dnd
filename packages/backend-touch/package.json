{
  "name": "react-dnd-touch-backend",
  "version": "16.0.1",
  "description": "Touch backend for react-dnd",
  "license": "MIT",
  "author": "Long Ho <holevietlong@gmail.com>",
  "homepage": "https://github.com/nosferatu500/react-dnd#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nosferatu500/react-dnd.git",
    "directory": "packages/backend-touch"
  },
  "bugs": {
    "url": "https://github.com/nosferatu500/react-dnd/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/cjs",
    "dist/esm",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "clean": "shx rm -rf dist .turbo tsconfig.tsbuildinfo",
    "_build_types": "tsc -b tsconfig.json",
    "_build_esm": "swc src -d dist/esm --strip-leading-paths -C module.type=es6 -C module.ignoreDynamic=true",
    "_build_cjs": "swc src -d dist/cjs --strip-leading-paths -C module.type=commonjs",
    "build": "run-p _build_types _build_esm _build_cjs && npm run _finalize",
    "check": "biome check src",
    "release": "npm publish --access public",
    "_finalize": "node ../../scripts/finalize-dist.mjs",
    "check:exports": "attw --pack . --profile node16"
  },
  "dependencies": {
    "@react-dnd/invariant": "^4.0.2",
    "dnd-core": "^16.0.1"
  }
}
