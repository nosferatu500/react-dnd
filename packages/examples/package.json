{
  "name": "@nosferatu500/react-dnd-examples",
  "version": "19.2.0",
  "private": true,
  "description": "React DnD example gallery (source of truth for the docsite)",
  "license": "MIT",
  "homepage": "https://github.com/nosferatu500/react-dnd#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nosferatu500/react-dnd.git",
    "directory": "packages/examples"
  },
  "bugs": {
    "url": "https://github.com/nosferatu500/react-dnd/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "clean": "shx rm -rf dist .turbo",
    "_build_types": "tsc -b tsconfig.json",
    "_build_esm": "swc src -d dist --strip-leading-paths --ignore '**/__tests__/**,**/__compat__/**,**/*.spec.ts,**/*.spec.tsx' -C module.type=es6",
    "_build_docs": "tsc -p tsconfig.docs.json",
    "_unjsxify": "node ../../scripts/unjsxify.mjs ./dist/docs",
    "build": "run-p _build_types _build_esm && run-s _build_docs _unjsxify",
    "check": "biome check src"
  },
  "dependencies": {
    "@faker-js/faker": "^10.1.0",
    "@nosferatu500/dnd-core": "^19.2.0",
    "@nosferatu500/react-dnd": "^19.2.0",
    "@nosferatu500/react-dnd-html5-backend": "^19.2.0",
    "immutability-helper": "^3.1.1",
    "lodash-es": "^4.17.21",
    "react-frame-component": "^5.2.7"
  },
  "devDependencies": {
    "@nosferatu500/react-dnd-test-utils": "^19.2.0",
    "@types/lodash-es": "^4.17.12"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
