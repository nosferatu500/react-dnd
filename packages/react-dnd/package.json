{
  "name": "react-dnd",
  "version": "16.0.1",
  "description": "Drag and Drop for React",
  "license": "MIT",
  "homepage": "https://github.com/nosferatu500/react-dnd#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nosferatu500/react-dnd.git",
    "directory": "packages/react-dnd"
  },
  "bugs": {
    "url": "https://github.com/nosferatu500/react-dnd/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/__tests__",
    "!src/**/__compat__",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "clean": "shx rm -rf dist .turbo tsconfig.tsbuildinfo",
    "_build_types": "tsc -b tsconfig.json",
    "_build_js": "swc src -d dist --strip-leading-paths --ignore '**/__tests__/**,**/__compat__/**,**/*.spec.ts,**/*.spec.tsx' -C module.type=es6 -C module.ignoreDynamic=true",
    "build": "run-p _build_types _build_js",
    "check": "biome check src",
    "check:exports": "attw --pack . --profile esm-only",
    "release": "npm publish --access public"
  },
  "dependencies": {
    "dnd-core": "^16.0.1",
    "fast-deep-equal": "^3.1.3"
  },
  "peerDependencies": {
    "@types/node": ">=22",
    "@types/react": "^18.0.0 || ^19.0.0",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@types/node": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    }
  }
}
