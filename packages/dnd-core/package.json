{
  "name": "@nosferatu500/dnd-core",
  "version": "19.2.0",
  "description": "Drag and drop sans the GUI",
  "license": "MIT",
  "author": "Vitalii Shvetsov",
  "contributors": [
    "Dan Abramov and the React DnD contributors"
  ],
  "keywords": [
    "react",
    "drag",
    "drop",
    "drag-and-drop",
    "dnd",
    "react-dnd",
    "state-machine",
    "backend-agnostic"
  ],
  "homepage": "https://github.com/nosferatu500/react-dnd#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nosferatu500/react-dnd.git",
    "directory": "packages/dnd-core"
  },
  "bugs": {
    "url": "https://github.com/nosferatu500/react-dnd/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/__tests__",
    "!src/**/__compat__",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "shx rm -rf dist .turbo tsconfig.tsbuildinfo",
    "_build_types": "tsc -b tsconfig.json",
    "_build_js": "swc src -d dist --strip-leading-paths --ignore '**/__tests__/**,**/__compat__/**,**/*.spec.ts,**/*.spec.tsx' -C module.type=es6 -C module.ignoreDynamic=true",
    "build": "run-p _build_types _build_js",
    "check": "biome check src",
    "check:exports": "attw --pack . --profile esm-only",
    "release": "npm publish --access public"
  },
  "dependencies": {
    "redux": "^5.0.1"
  },
  "devDependencies": {
    "@types/setimmediate": "^1.0.2",
    "setimmediate": "^1.0.5"
  }
}
